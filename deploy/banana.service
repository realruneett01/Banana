[Unit]
Description=Banana hardware diff server
After=network.target
Documentation=file:///opt/banana/README.md

[Service]
Type=simple
User=banana
Group=banana
WorkingDirectory=/opt/banana
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=5000
Environment=BANANA_TEMP_DIR=/var/tmp/banana
Environment=HOME=/var/tmp/banana
Environment=XDG_CONFIG_HOME=/var/tmp/banana/config
Environment=XDG_CACHE_HOME=/var/tmp/banana/cache
EnvironmentFile=-/etc/banana/banana.env
ExecStartPre=/usr/bin/env node /opt/banana/scripts/preflight.mjs --skip-selftest --no-write
ExecStart=/usr/bin/env node /opt/banana/backend/src/server.js
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/tmp/banana
StateDirectory=banana
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
